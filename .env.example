# Public site URL (used for canonical, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.brightgoldkodungallur.com

# Cloudinary cloud name (assets are referenced by full HTTPS URL in config/brand.ts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=nplfkyjy

# Password for /admin (the daily gold-rate desk). A long one is safer than a PIN.
ADMIN_PASSWORD=change-me
# Long random value (32+ characters) that signs the admin session cookie. Required in
# production; never share it. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Where daily rates are stored. Add "Upstash for Redis" from the Vercel
# Marketplace and Vercel fills these in. Without them, local dev saves to
# .data/gold-rates.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
