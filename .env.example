# Public site URL (used for canonical, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.brightgoldkodungallur.com

# Cloudinary cloud name (assets are referenced by full HTTPS URL in config/brand.ts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=nplfkyjy

# Password for /admin (the daily gold-rate desk). A long one is safer than a PIN.
ADMIN_PASSWORD=change-me
# Long random value (32+ characters) that signs the admin session cookie. Required in
# production; never share it. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Where daily rates are stored, either:
#  1. Vercel Edge Config (free, no redeploy when a rate changes; keeps the newest
#     ~40 days). EDGE_CONFIG is the read connection string Vercel sets when the
#     store is connected to the project. Saving also needs a Vercel API token for
#     that team, and the team id.
EDGE_CONFIG=
EDGE_CONFIG_WRITE_TOKEN=
EDGE_CONFIG_TEAM_ID=
#  2. "Upstash for Redis" from the Vercel Marketplace; Vercel fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# With neither, local dev saves to .data/gold-rates.json.
